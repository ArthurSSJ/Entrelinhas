# Copie para .env.local e preencha o que já existir.
# Sem nada preenchido, o site roda em modo demonstração: a leitura é simulada
# e o pagamento tem um botão de atalho.

# URL pública do site. Usada no callback do N8n e no retorno do checkout.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Groq — o agente que lê a conversa
# ---------------------------------------------------------------
# Chave em https://console.groq.com/keys. Basta isto para o site funcionar
# de ponta a ponta, sem N8n.
GROQ_API_KEY=
# Opcional. Padrão: llama-3.3-70b-versatile
GROQ_MODEL=
# Entra quando o modelo acima está congestionado. Padrão: llama-3.1-8b-instant
GROQ_MODEL_RESERVA=
# Teto de tokens por minuto do seu plano, usado pela fila. Padrão: 12000 (gratuito).
# Confira o seu em https://console.groq.com/settings/limits
GROQ_TPM=

# ---------------------------------------------------------------
# N8n — alternativa ao agente acima
# ---------------------------------------------------------------
# Se estiver preenchida, o arquivo vai para o N8n e o Groq é ignorado.
# Webhook que recebe o arquivo (multipart: arquivo, analiseId, avancada, callbackUrl).
N8N_WEBHOOK_URL=
# Opcional: vai como "Authorization: Bearer …" na chamada acima.
N8N_WEBHOOK_TOKEN=
# Opcional: o N8n precisa devolver este valor no header x-desvenda-token.
N8N_CALLBACK_TOKEN=

# ---------------------------------------------------------------
# Cakto — checkout
# ---------------------------------------------------------------
# Link do checkout do produto base (relatório sozinho).
CAKTO_CHECKOUT_URL=
# Link do produto com a investigação avançada inclusa (order bump marcado e
# oferta de recuperação). Se vazio, usa o de cima.
CAKTO_CHECKOUT_URL_AVANCADA=
# Link do produto que vende SÓ a investigação avançada (upsell e downsell,
# depois de o relatório já ter sido pago). Se vazio, usa o de cima.
CAKTO_CHECKOUT_URL_SO_AVANCADA=
# Opcional: confere o header x-cakto-token no postback.
CAKTO_WEBHOOK_TOKEN=
#
# IMPORTANTE: o que cada pagamento libera viaja na referência do pedido, no
# formato "<id-da-analise>~<rel|av|rel_av>". Configure o postback da Cakto para
# devolver esse valor (ref, utm_content, src ou external_reference): é por ele
# que o site sabe se deve liberar o relatório, a avançada, ou os dois.

# ---------------------------------------------------------------
# PIX direto (alternativa ao checkout externo)
# ---------------------------------------------------------------
PIX_CHAVE=
PIX_NOME=DESVENDA AI
PIX_CIDADE=SAO PAULO

# ---------------------------------------------------------------
# Preços, em centavos
# ---------------------------------------------------------------
# Relatório.
NEXT_PUBLIC_PRECO_BASE=1990
# Investigação avançada: order bump no checkout e upsell depois da compra.
NEXT_PUBLIC_PRECO_AVANCADA=990
# Investigação avançada no downsell, oferecida uma única vez a quem recusou
# o upsell. O servidor só aceita este preço com a recusa registrada.
NEXT_PUBLIC_PRECO_DOWNSELL=490
# Pacote da oferta de recuperação: relatório + avançada juntos.
NEXT_PUBLIC_PRECO_PACOTE=1990

# ---------------------------------------------------------------
# Oferta de recuperação (variante de teste)
# ---------------------------------------------------------------
# "true" liga o pacote acima no popup de saída, para quem ainda não comprou.
# Desligada, o popup mostra só o preço normal — sem promoção inventada.
NEXT_PUBLIC_OFERTA_RECUPERACAO=false

# ---------------------------------------------------------------
# Supabase Analytics & Dashboard Admin
# ---------------------------------------------------------------
# URL pública do projeto Supabase (Configurações -> API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave Anônima Pública (anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
# Chave Privilegiada de Serviço (service_role key) - Usada no servidor
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Senha de acesso ao Dashboard Admin (/admin/login). TROQUE ANTES DE PUBLICAR:
# esta é a senha de exemplo e ela dá acesso ao painel de métricas.
ADMIN_PASSWORD=admin123entrelinhas
