# Copie para .env.local e preencha o que já existir.
# Sem nada preenchido, o site roda em modo demonstração: a leitura é simulada
# e o pagamento tem um botão de atalho.

# URL pública do site. Usada no callback do N8n e no retorno do checkout.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Groq — o agente que lê a conversa
# ---------------------------------------------------------------
# Chave em https://console.groq.com/keys. Basta isto para o site funcionar
# de ponta a ponta, sem N8n.
GROQ_API_KEY=
# Opcional. Padrão: llama-3.3-70b-versatile
GROQ_MODEL=
# Entra quando o modelo acima está congestionado. Padrão: llama-3.1-8b-instant
GROQ_MODEL_RESERVA=
# Teto de tokens por minuto do seu plano, usado pela fila. Padrão: 12000 (gratuito).
# Confira o seu em https://console.groq.com/settings/limits
GROQ_TPM=

# ---------------------------------------------------------------
# N8n — alternativa ao agente acima
# ---------------------------------------------------------------
# Se estiver preenchida, o arquivo vai para o N8n e o Groq é ignorado.
# Webhook que recebe o arquivo (multipart: arquivo, analiseId, avancada, callbackUrl).
N8N_WEBHOOK_URL=
# Opcional: vai como "Authorization: Bearer …" na chamada acima.
N8N_WEBHOOK_TOKEN=
# Opcional: o N8n precisa devolver este valor no header x-desvenda-token.
N8N_CALLBACK_TOKEN=

# ---------------------------------------------------------------
# Cakto — checkout
# ---------------------------------------------------------------
# Link do checkout do produto base.
CAKTO_CHECKOUT_URL=
# Link do produto com a análise avançada inclusa. Se vazio, usa o de cima.
CAKTO_CHECKOUT_URL_AVANCADA=
# Opcional: confere o header x-cakto-token no postback.
CAKTO_WEBHOOK_TOKEN=

# ---------------------------------------------------------------
# PIX direto (alternativa ao checkout externo)
# ---------------------------------------------------------------
PIX_CHAVE=
PIX_NOME=DESVENDA AI
PIX_CIDADE=SAO PAULO

# ---------------------------------------------------------------
# Preços, em centavos
# ---------------------------------------------------------------
NEXT_PUBLIC_PRECO_BASE=1990
NEXT_PUBLIC_PRECO_AVANCADA=990
